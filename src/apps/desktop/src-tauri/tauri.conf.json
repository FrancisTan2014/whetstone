{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whetstone",
  "version": "0.1.0",
  "identifier": "com.whetstone.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeBuildCommand": "pnpm --filter @whetstone/web build",
    "beforeDevCommand": "pnpm --filter @whetstone/web dev",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
