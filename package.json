{
  "name": "whetstone",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup": "node scripts/setup.mjs",
    "setup:doctor": "node scripts/setup.mjs --check",
    "setup:minimal": "node scripts/setup.mjs --minimal",
    "setup:voice": "node scripts/setup.mjs --voice",
    "setup:ai": "node scripts/setup.mjs --ai",
    "setup:coach": "node scripts/setup.mjs --coach",
    "setup:pdf": "node scripts/setup.mjs --pdf",
    "setup:all": "node scripts/setup.mjs --all",
    "calibrate:voice": "node scripts/voice/calibrate.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "pnpm lint:eslint && pnpm format:check",
    "lint:eslint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/apps/**/*.{ts,tsx,css,html,json}\" \"src/packages/**/*.{ts,json}\" \"scripts/build/*.mjs\" \"scripts/delivery/*.mjs\" \"*.{json,yml,yaml}\" \"vitest*.config.ts\" \".github/workflows/*.{yml,yaml}\" \"README.md\"",
    "format:check": "prettier --check \"src/apps/**/*.{ts,tsx,css,html,json}\" \"src/packages/**/*.{ts,json}\" \"scripts/build/*.mjs\" \"scripts/delivery/*.mjs\" \"*.{json,yml,yaml}\" \"vitest*.config.ts\" \".github/workflows/*.{yml,yaml}\" \"README.md\"",
    "test": "pnpm test:quality && pnpm test:isolated && pnpm test:workflow && pnpm test:python",
    "test:changed": "vitest run --changed origin/main --coverage --coverage.changed origin/main --passWithNoTests && pnpm test:workflow",
    "test:isolated": "vitest run --config vitest.isolated.config.ts",
    "test:python": "node scripts/run-python-tests.mjs -m unittest discover -s src/apps/server/src/files/tests -v",
    "test:quality": "vitest run --coverage",
    "test:quality:shard": "vitest run --reporter=blob --coverage --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0",
    "test:quality:merge": "vitest run --mergeReports --reporter=default --coverage",
    "test:workflow": "node --test --experimental-test-coverage --test-coverage-include=scripts/delivery/supervisor.mjs --test-coverage-include=scripts/delivery/workflow.mjs --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 scripts/delivery/health.test.mjs scripts/delivery/launchers.test.mjs scripts/delivery/supervisor.test.mjs scripts/delivery/workflow.test.mjs",
    "mutation": "stryker run",
    "build": "pnpm --filter @whetstone/document build && pnpm --filter @whetstone/domain build && pnpm --filter @whetstone/contracts build && pnpm --filter @whetstone/server build && pnpm --filter @whetstone/web build",
    "smoke": "pnpm --filter @whetstone/web smoke",
    "size-limit": "size-limit",
    "lighthouse": "lhci autorun",
    "screenshots": "node scripts/screenshots.mjs",
    "delivery:health": "node scripts/delivery/health.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "validate": "pnpm validate:quality && pnpm validate:runtime && pnpm validate:isolated",
    "validate:changed": "pnpm typecheck && pnpm lint && pnpm test:changed && pnpm build && pnpm size-limit && pnpm smoke",
    "validate:isolated": "pnpm test:isolated && pnpm test:workflow && pnpm test:python",
    "validate:quality": "pnpm typecheck && pnpm lint && pnpm test:quality",
    "validate:runtime": "pnpm build && pnpm size-limit && pnpm smoke && pnpm e2e",
    "db:generate": "drizzle-kit generate",
    "data:backup": "node --import tsx --env-file-if-exists=.env src/apps/server/src/data/backupCli.ts",
    "data:restore": "node --import tsx --env-file-if-exists=.env src/apps/server/src/data/restoreCli.ts",
    "pdf:remap": "node --import tsx --env-file-if-exists=.env src/apps/server/src/features/pdfImport/pdfWorkRemapCli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@size-limit/file": "^12.1.0",
    "@stryker-mutator/api": "^9.6.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.6.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.61.1",
    "prettier": "^3.8.4",
    "size-limit": "^12.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
